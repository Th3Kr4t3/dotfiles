{{- /* Per-machine data. Prompts run once; answers are stored in ~/.config/chezmoi/chezmoi.toml. */ -}}
{{- $name := promptStringOnce . "name" "Git name" "Miguel Castillo" -}}
{{- $email := promptStringOnce . "email" "Git email" "31254901+Th3Kr4t3@users.noreply.github.com" -}}

{{- $isContainer := false -}}
{{- if or (stat "/.dockerenv") (stat "/run/.containerenv") (env "CODESPACES") (env "REMOTE_CONTAINERS") -}}
{{-   $isContainer = true -}}
{{- end -}}

{{- /* Containers on a WSL host share its kernel, so rule them out first. */ -}}
{{- $isWSL := false -}}
{{- if and (eq .chezmoi.os "linux") (not $isContainer) -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $isWSL = true -}}
{{-   end -}}
{{- end }}
{{- /* DOTFILES_PROFILE overrides detection: install.sh sets "container", the machine test sets "machine". */ -}}
{{- if eq (env "DOTFILES_PROFILE") "machine" -}}
{{-   $isContainer = false -}}
{{- else if eq (env "DOTFILES_PROFILE") "container" -}}
{{-   $isContainer = true -}}
{{- end }}
{{ if $isContainer -}}
# Containers apply from wherever install.sh was cloned (e.g. Codespaces), so remember it.
sourceDir = {{ .chezmoi.workingTree | quote }}
{{ end -}}
{{ if eq .chezmoi.os "windows" -}}
# Windows reads the canonical clone in WSL, so there is one repo to edit and commit.
sourceDir = {{ .chezmoi.workingTree | quote }}

# The PowerShell execution policy is Restricted by default; scripts run with Bypass.
[interpreters.ps1]
  command = "powershell"
  args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
{{ end }}
# Templates that read Bitwarden unlock the vault on demand (asks for the master password).
[bitwarden]
  unlock = "auto"

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  isContainer = {{ $isContainer }}
  isWSL = {{ $isWSL }}
