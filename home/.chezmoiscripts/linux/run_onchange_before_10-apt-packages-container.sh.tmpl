{{- if .isContainer -}}
#!/usr/bin/env bash
# Light package list for dev containers and Codespaces: the shell experience only.
# Packages the image's distro doesn't have are skipped instead of failing the whole apply.
set -euo pipefail

packages=(fzf ripgrep zoxide zsh zsh-autosuggestions zsh-syntax-highlighting)

if ! command -v apt-get >/dev/null 2>&1; then
  echo "apt-get not found; skipping shell packages"; exit 0
fi
SUDO=""
if [ "$(id -u)" -ne 0 ]; then
  command -v sudo >/dev/null 2>&1 || { echo "not root and no sudo; skipping shell packages"; exit 0; }
  SUDO="sudo"
fi

$SUDO apt-get update -y
available=()
for p in "${packages[@]}"; do
  apt-cache show "$p" >/dev/null 2>&1 && available+=("$p")
done
$SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y "${available[@]}"
{{- end }}
